{
  "name": "cline-shengsuan",
  "displayName": "DSH Cline",
  "description": "Open-source DeepSeek Harness + Cline VS Code extension (agent, live diff, MCP)",
  "version": "4.5.1",
  "license": "MIT",
  "publisher": "shengsuan-cloud",
  "private": false,
  "icon": "media/dsh-cline.png",
  "keywords": [
    "deepseek",
    "harness",
    "agent",
    "agent-ai",
    "autonomous",
    "chatgpt",
    "claude",
    "cline",
    "coding",
    "dev",
    "keybindings",
    "llama",
    "mcp",
    "skill",
    "ai",
    "openrouter",
    "sonnet"
  ],
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Machine Learning",
    "Programming Languages",
    "Debuggers",
    "Testing",
    "SCM Providers"
  ],
  "main": "./dist/extension.js",
  "files": [
    "dist",
    "media",
    "README.md",
    "LICENSE"
  ],
  "vsce": {
    "baseImagesUrl": "https://raw.githubusercontent.com/DM010727/dsh-cline/main/packages/extension"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dsh-cline",
          "title": "DSH Cline",
          "icon": "media/dsh-cline-sidebar-small.png"
        }
      ]
    },
    "views": {
      "dsh-cline": [
        {
          "type": "webview",
          "id": "dsh-cline.sidebar",
          "name": "DSH Cline"
        }
      ]
    },
    "commands": [
      {
        "command": "dsh-cline.openPanel",
        "title": "在编辑器面板中打开",
        "category": "DSH Cline"
      },
      {
        "command": "dsh-cline.restoreCheckpoint",
        "title": "恢复检查点...",
        "category": "DSH Cline"
      },
      {
        "command": "dsh-cline.restartSidecar",
        "title": "重启 DSH 服务",
        "category": "DSH Cline"
      },
      {
        "command": "dsh-cline.addToChat",
        "title": "添加到 DSH Cline",
        "category": "DSH Cline"
      },
      {
        "command": "dsh-cline.explainCode",
        "title": "用 DSH Cline 解释",
        "category": "DSH Cline"
      },
      {
        "command": "dsh-cline.improveCode",
        "title": "用 DSH Cline 优化",
        "category": "DSH Cline"
      },
      {
        "command": "dsh-cline.showLastDiff",
        "title": "重新打开最近一次变更 diff",
        "category": "DSH Cline"
      },
      {
        "command": "dsh-cline.cleanupDshProcesses",
        "title": "清理残留 DSH 进程...",
        "category": "DSH Cline"
      },
      {
        "command": "dsh-cline.updateRuntime",
        "title": "安装／升级 DSH 运行时到 0.2.1-rc.2",
        "category": "DSH Cline"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "dsh-cline.addToChat",
          "group": "navigation@1",
          "when": "editorHasSelection"
        },
        {
          "command": "dsh-cline.explainCode",
          "group": "navigation@2",
          "when": "editorHasSelection"
        },
        {
          "command": "dsh-cline.improveCode",
          "group": "navigation@3",
          "when": "editorHasSelection"
        }
      ]
    },
    "configuration": {
      "title": "DSH Cline",
      "properties": {
        "dsh-cline.dshCommand": {
          "type": "string",
          "default": "dsh",
          "markdownDescription": "从 4.3.1 起扩展使用独立、锁定且校验安全补丁的 DSH 运行时。使用「DSH Cline: 安装／升级 DSH 运行时」安装或修复；此旧设置不再用于启动服务。",
          "deprecationMessage": "已改用扩展专用运行时，此设置不再使用。"
        },
        "dsh-cline.host": {
          "type": "string",
          "default": "127.0.0.1",
          "markdownDescription": "DSH 服务绑定地址（DSH 仅支持 127.0.0.1）。",
          "enum": [
            "127.0.0.1",
            "localhost"
          ]
        },
        "dsh-cline.diffOnEdit": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "在已批准的 edit/write 工具写入前捕获原稿，并在 VS Code 原生 diff 编辑器中显示变更预览。"
        },
        "dsh-cline.port": {
          "type": "integer",
          "default": 52341,
          "markdownDescription": "手动指定本工作区的服务端口。不显式配置时按工作区路径分配稳定端口，避免多窗口串线；只绑定插件标识和工作区均匹配的实例。",
          "minimum": 1024,
          "maximum": 65535
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@dsh-cline/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DM010727/dsh-cline.git"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "DSH can execute tools and commands; open a trusted workspace to enable it."
    }
  }
}
