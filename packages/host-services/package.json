{
  "name": "@dsh-cline/host-services",
  "version": "0.8.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "DSH Cordis host bridge and recommended Shengsuanyun configuration; native DeepSeek onboarding and Models remain authoritative.",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-cordis-client-runner",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-api-session-controller"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "lib",
    "scripts/install-lock.mjs",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node esbuild.client.mjs",
    "build:client": "node esbuild.client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json",
    "install:profile": "node scripts/install-profile.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "esbuild": "^0.25.0",
    "react": "^18.2.0",
    "typescript": "^5.8.0"
  }
}
